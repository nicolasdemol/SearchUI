{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
    "name": "searchui",
    "version-string": "1.2.0",
    "port-version": 0,
    "description": "SearchUI item search for Skyrim SE, AE and VR.",
    "homepage": "https://www.nexusmods.com/skyrimspecialedition/mods/155713",
    "license": "Apache-2.0",
    "features": {
        "scripts": {
            "description": "Install Papyrus sources for this program to develop on top of it."
        },
        "scripts-dev": {
            "description": "Install Papyrus sources necessary to develop scripts for this plugin.",
            "dependencies": [
                "bethesda-skyrim-scripts",
                {
                    "name": "skse",
                    "default-features": false,
                    "features": [
                        "scripts"
                    ]
                }
            ]
        },
        "plugin": {
            "description": "Build the SKSE plugin.",
            "dependencies": [
                {
                    "version>=": "2025-10-27",
                    "name": "directxtk"
                },
                {
                    "version>=": "12.1.0",
                    "name": "fmt"
                },
                {
                    "version>=": "8.90",
                    "name": "rapidcsv"
                },
                {
                    "version>=": "1.16.0",
                    "name": "spdlog"
                },
                "yaml-cpp"
            ]
        },
        "tests": {
            "description": "Build tests for the SKSE plugin.",
            "dependencies": [
                {
                    "name": "searchui",
                    "default-features": false,
                    "features": [
                        "plugin"
                    ]
                }
            ]
        }
    },
    "default-features": [
        "plugin"
    ]
}
